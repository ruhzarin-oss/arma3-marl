        texts[]  = {"NON","OUI"};
        default  = 0;
    };
    class CHACAL_OBS
    {
        title = "Phase 3 OBSERVATION : 1 = jouee, 0 = coupee (verdict : 110 echecs sur 111)";
        values[] = {0,1};
        texts[]  = {"COUPEE","JOUEE"};
        default  = 1;
    };
    class CHACAL_AZIMUT_VAL
    {
        title = "Azimut impose, en degres (mode 2)";
        values[] = {0,30,60,90,120,150,180,210,240,270,300,330};
        texts[]  = {"0","30","60","90","120","150","180","210","240","270","300","330"};
        default  = 0;
    };
    class CHACAL_EXFIL
    {
        title = "Exfiltration : 0 = reference, 1 = AWARE apres rupture de contact, 2 = budget a 1,2 m/s";
        values[] = {0,1,2};
        texts[]  = {"REFERENCE","AWARE","BUDGET"};
        default  = 0;
    };
    class CHACAL_TACTIQUE
    {
        title = "Tactique : 0 socle seul, 1 base de feu, 2 neutralisation prealable, 5 infiltration";
        values[] = {0,1,2,5};
        texts[]  = {"SOCLE","T1","T2","T5"};
        default = 0;
    };
    class CHACAL_ORACLE
    {
        title = "Oracle : 0 non, 1 a l assaut, 2 complet (avant le choix de la porte)";
        values[] = {0,1,2};
        texts[]  = {"NON","ASSAUT","COMPLET"};
        default = 0;
    };
    class CHACAL_MG_ASSAUT
    {
        title = "Mitrailleuse Mk200 a l adjoint de l assaut (0 = non)";
        values[] = {0,1};
        texts[]  = {"NON","OUI"};
        default = 0;
    };
    class CHACAL_DELAI_PORTEUR
    {
        title = "Delai du porteur vers le point de pose, en secondes (45 = origine)";
        values[] = {45,60,90,120,180};
        texts[]  = {"45","60","90","120","180"};
        default = 45;
    };
