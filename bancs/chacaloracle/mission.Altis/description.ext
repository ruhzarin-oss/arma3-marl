    class CHACAL_BRAS
    {
        title = "Bras : 0 = PLAN en six phases, 1 = TEMOIN qui marche droit";
        values[] = {0,1};
        texts[]  = {"PLAN","NUL"};
        default = 0;
    };
    // Controle positif de l observation : le meme episode en plein jour.
    // Diagnostic, marque hors corpus.
    class CHACAL_JOUR
    {
        title = "Heure : 0 = nuit (01h30), 1 = plein jour (12h30, DIAGNOSTIC)";
        values[] = {0,1};
        texts[]  = {"NUIT","JOUR"};
        default = 0;
    };
    class CHACAL_DEPART
    {
        title = "Phase de depart : 1 = complet, 2 = a la route, 3 = au regroupement, 4/5/6 = elements en place (DIAGNOSTIC)";
        values[] = {1,2,3,4,5,6};
        texts[]  = {"1","2","3","4","5","6"};
        default = 1;
    };
    // ! LA VIGNETTE. Une mission complete coute trois heures ; une question qui
    // ne porte que sur l assaut n a pas besoin des deux heures de marche qui le
    // precedent. CHACAL_ARRET ferme l episode DES QUE la phase demandee se
    // termine - proprement, par le verdict, pas par le plafond du lanceur.
    // Avec DEPART on choisit ou l on commence, avec ARRET ou l on s arrete :
    // DEPART=4, ARRET=5 est la vignette " assaut seul ".
    // Le defaut 6 laisse la mission complete rigoureusement inchangee.
    class CHACAL_ARRET
    {
        title = "Derniere phase jouee : l episode se termine des qu elle se clot (6 = mission complete)";
        values[] = {1,2,3,4,5,6};
        texts[]  = {"1","2","3","4","5","6"};
        default = 6;
    };
    // ! LE PARTAGE DE L EFFECTIF, LEVIER OUVERT LE 16/09. Jusque-la les trois elements
    // etaient ecrits en dur dans 40_blufor.sqf. Le verdict la-porte-nest-pas-une-decision
    // a montre que le seul choix offert par la mission - par quelle ouverture entrer -
    // ne change pas l issue : les deux portes sont echangeables. Le partage, lui, ne l est
    // pas : cinq hommes a l objectif n est pas la meme puissance de feu que sept, et trois
    // sur la route n est pas le meme barrage qu un seul.
    class CHACAL_PARTAGE
    {
        title = "Partage de l effectif : 0 = 5 assaut / 3 bouchon, 1 = 7 assaut / 1 bouchon";
        values[] = {0,1};
        texts[]  = {"5/3","7/1"};
        default = 0;
    };
    // ! LA RESERVE ENNEMIE, RENDUE PILOTABLE LE 16/09. Au palier 4 la table donne ZERO
    // vehicule de reserve et un delai de 9999 s : la reserve n existe pas, et le bouchon
    // garde une route ou personne ne passe - 31 coups tires sur 5753, mesure du 15/09.
    // Sans reserve, la question " combien d hommes au bouchon " n a pas d objet.
    // -1 laisse la table du palier intacte : aucun job anterieur ne change de comportement.
    class CHACAL_QRF_N
    {
        title = "Vehicules de reserve adverse : -1 = valeur du palier, 0 = aucune";
        values[] = {-1,0,1,2};
        texts[]  = {"palier","0","1","2"};
        default = -1;
    };
    class CHACAL_QRF_DELAI
    {
        title = "Secondes avant depart de la reserve : -1 = valeur du palier, 9999 = jamais";
        values[] = {-1,45,120,300,600,9999};
        texts[]  = {"palier","45","120","300","600","jamais"};
        default = -1;
    };
    // ! LA RESERVE RAPPROCHEE ( 16/09 ). Le controle CONTROLE-PARTAGE-16-09 a montre que la
    // reserve, tiree a 5-7 km sur route, roule a environ 5 m/s et se trouve ENCORE a 5,5 km
    // du site quand l episode se ferme a arret=5 : zero tir, jamais au contact du bouchon.
    // Le partage 5/3 contre 7/1 redevenait donc echangeable. Ce levier rapproche la base
    // APRES le tirage du monde, sans consommer d alea : la graine garde son site.
    // Minimum 1000 : sous 900 m, le plafond de la phase 4 ( _dMep ) changerait aussi.
    class CHACAL_QRF_DIST
    {
        title = "Distance imposee de la base de reserve au site, en metres : -1 = tirage 5-7 km";
        values[] = {-1,1000,1500,2000,3000};
        texts[]  = {"tirage","1000","1500","2000","3000"};
        default = -1;
    };
    // ! ACCELERATION MOTEUR ( 16/09 ). setAccTime a ete MESURE INERTE sur serveur dedie le
    // 11/06 ( calib_stepgame.py : temps de jeu / temps mur = 1,11 ). Ce levier existe pour
    // le re-mesurer dans CHACAL : il journalise le temps de jeu, le temps reel et ce que le
    // moteur rapporte. Tout episode a ACC different de 1 est hors corpus.
    class CHACAL_ACC
    {
        title = "Acceleration demandee au moteur ( setAccTime ) : 1 = temps reel";
        values[] = {1,2,4};
        texts[]  = {"x1","x2","x4"};
        default = 1;
    };
    // ! LA SITUATION ( 16/09 ). Des menaces qui varient d un episode a l autre dans chacune des six
