        title = "Ablation : 0 socle complet, 1 sans chien de garde, 2 sans porteurs non combattants, 4 sans appui cloue, 8 sans revelation";
        values[] = {0,1,2,4,8};
        texts[]  = {"COMPLET","SANS CHIEN","SANS PORTEURS","SANS APPUI CLOUE","SANS REVELATION"};
        default = 0;
    };
